PORT=3000

# Ambiente: development (padrão) ou production.
# Em production, o cookie de login passa a exigir HTTPS.
NODE_ENV=development

# Uso local: preencha as variáveis abaixo.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=car_dealer
DB_USER=postgres
DB_PASSWORD=

# No Render, o banco gerenciado fornece essa variável
# pronta — quando definida, ela tem prioridade sobre
# as variáveis DB_* acima.
DATABASE_URL=

JWT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# IA de edição de imagem (Luma Photon) usada para gerar a capa
# profissional do veículo a partir de uma foto real.
# Sem essa variável, o botão "Gerar capa profissional com IA" retorna 503.
LUMA_API_KEY=

META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=

# Armazenamento de imagens dos veículos (Cloudinary).
# Sem essas 3 variáveis, upload de imagem retorna 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Domínios do frontend liberados no CORS, separados por vírgula.
# Sem essa variável, o backend libera apenas endereços de rede local.
# Exemplo em produção: ALLOWED_ORIGINS=https://app.suarevenda.com.br
ALLOWED_ORIGINS=
