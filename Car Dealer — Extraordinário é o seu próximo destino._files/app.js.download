'use strict';
const vehicles=[{name:'911 Carrera',brand:'PORSCHE',price:789000,year:2023,km:'12.500 km',type:'Esportivo',image:'https://www.westcoastexoticcars.com/imagetag/1384/6/l/Used-2021-Porsche-911-Carrera-1680213012.jpg',description:'Uma escolha para quem coloca o prazer de dirigir em primeiro lugar. Seu perfil esportivo prioriza performance e uma experiência envolvente ao volante.'},{name:'530i M Sport',brand:'BMW',price:279900,year:2023,km:'24.000 km',type:'Sedã',image:'https://imgcdn.sayaratbay.com/large/gallery/exterior/4/42/bmw-5-series-sedan-drivers-sideview-619650.jpg',description:'Um sedã para combinar rotina e prazer de dirigir, com uma proposta equilibrada entre conforto, presença e perfil esportivo.'},{name:'GLC 300',brand:'MERCEDES-BENZ',price:389900,year:2023,km:'18.000 km',type:'SUV',image:'https://cdn.autoproyecto.com/wp-content/uploads/2023/03/Mercedes-Benz-GLC-2023-4.jpg',description:'Uma opção para quem valoriza espaço e conforto no dia a dia e nas viagens. Vale conhecer pessoalmente o espaço interno e o porta-malas.'}];
const money=n=>n.toLocaleString('pt-BR',{style:'currency',currency:'BRL',maximumFractionDigits:0});
const stock=document.querySelector('#stock');const dialog=document.querySelector('#detail');
function renderStock(filter='all'){const list=vehicles.filter(v=>filter==='all'||v.type===filter);stock.innerHTML=list.map(v=>`<article class="vehicle"><div class="vehicle-photo"><img src="${v.image}" alt="${v.brand} ${v.name}" loading="lazy"><span>${v.type.toUpperCase()}</span></div><div class="vehicle-body"><small>${v.brand}</small><h3>${v.name}</h3><div class="specs"><span>${v.year}</span><span>${v.km}</span><span>Automático</span></div><div class="vehicle-price"><strong>${money(v.price)}</strong><button data-detail="${vehicles.indexOf(v)}" aria-label="Ver detalhes do ${v.name}">↗</button></div></div></article>`).join('');document.querySelector('#stock-count').textContent=`${String(list.length).padStart(2,'0')} veículo${list.length===1?'':'s'} selecionado${list.length===1?'':'s'}`;}
renderStock();document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('active',x===b));renderStock(b.dataset.filter)}));
function showDetail(i){const v=vehicles[i];document.querySelector('#detail-content').innerHTML=`<img class="detail-img" src="${v.image}" alt="${v.brand} ${v.name}"><p class="eyebrow">${v.brand} / ${v.type}</p><h2>${v.name}</h2><div class="specs"><span>${v.year}</span><span>${v.km}</span><span>Automático</span></div><h3 style="margin-top:20px">${money(v.price)}</h3><p>${v.description}</p><p class="fine">Veículo demonstrativo. Confirme versão, equipamentos, documentação e disponibilidade com a revenda.</p><button class="button" id="interest">Tenho interesse neste veículo ↗</button>`;if(!dialog.open)dialog.showModal();document.querySelector('#interest').onclick=()=>contact(`Olá! Tenho interesse no ${v.brand} ${v.name}, anunciado por ${money(v.price)}. Gostaria de confirmar disponibilidade e agendar uma visita.`)}
document.addEventListener('click',e=>{const b=e.target.closest('[data-detail]');if(b)showDetail(Number(b.dataset.detail))});document.querySelector('.close').onclick=()=>dialog.close();dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close()}});
const menu=document.querySelector('#menu');menu.onclick=()=>{const open=document.querySelector('#navigation').classList.toggle('open');menu.setAttribute('aria-expanded',open);menu.setAttribute('aria-label',open?'Fechar menu':'Abrir menu')};document.querySelectorAll('nav a').forEach(a=>a.onclick=()=>{document.querySelector('#navigation').classList.remove('open');menu.setAttribute('aria-expanded','false')});
document.querySelector('#match-form').onsubmit=e=>{e.preventDefault();const profile=new FormData(e.target).get('profile'),budget=Number(document.querySelector('#budget').value);const affordable=vehicles.filter(v=>v.price<=budget);const best=affordable.find(v=>v.type===profile)||affordable[0];const output=document.querySelector('#match-result');if(!best){output.textContent='Ainda não há veículos nesta faixa. Experimente outro orçamento ou converse com a revenda.';return}const exact=best.type===profile;output.innerHTML=`<p><b>${exact?'Seu match na coleção':'Uma alternativa dentro do orçamento'}: ${best.brand} ${best.name}</b></p><p>${exact?best.description:`Não temos um ${profile.toLowerCase()} nesta faixa. O ${best.name} cabe no orçamento, mas tem proposta de ${best.type.toLowerCase()}.`}</p><p><b>${money(best.price)}</b> · ${money(budget-best.price)} abaixo do limite informado.</p><button class="text-link" data-detail="${vehicles.indexOf(best)}">Conhecer este veículo ↗</button>`};
function calculate(){const price=Number(document.querySelector('#vehicle-price').value),pct=Number(document.querySelector('#entry').value),months=Number(document.querySelector('#months').value),entry=price*pct/100,principal=price-entry,rate=.0149,payment=principal*rate/(1-Math.pow(1+rate,-months));document.querySelector('#entry-value').textContent=`${money(entry)} (${pct}%)`;document.querySelector('#payment-value').textContent=money(payment);document.querySelector('#finance-total').textContent=`${months} meses · saldo ${money(principal)}`;return {price,entry,months,payment}}
['vehicle-price','entry','months'].forEach(id=>document.getElementById(id).addEventListener('input',calculate));calculate();document.querySelector('#finance-form').onsubmit=e=>e.preventDefault();
function contact(message){document.querySelector('#detail-content').innerHTML='<p class="eyebrow">SEU PRÓXIMO PASSO</p><h2>Vamos iniciar uma conversa.</h2><p>O contato da revenda ainda não foi configurado nesta demonstração. Copie sua mensagem para compartilhar com o vendedor.</p><textarea id="message" aria-label="Mensagem de interesse"></textarea><button class="button" id="copy">Copiar mensagem ↗</button><p id="copy-status" role="status"></p>';document.querySelector('#message').value=message;if(!dialog.open)dialog.showModal();document.querySelector('#copy').onclick=async()=>{try{await navigator.clipboard.writeText(document.querySelector('#message').value);document.querySelector('#copy-status').textContent='Mensagem copiada. Agora você pode enviá-la ao vendedor.'}catch{document.querySelector('#message').select();document.querySelector('#copy-status').textContent='Selecione e copie a mensagem acima.'}}}
document.querySelector('#finance-contact').onclick=()=>{const f=calculate();contact(`Olá! Gostaria de consultar financiamento para um veículo de ${money(f.price)}, com entrada de ${money(f.entry)} em ${f.months} meses. Podem me informar as taxas, o CET e as condições?`)};document.querySelector('#visit').onclick=()=>contact('Olá! Gostaria de conhecer a loja e agendar uma visita. Qual é o endereço e quais horários estão disponíveis?');
